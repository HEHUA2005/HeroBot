# Copy this file to instances/other.env and fill a different BotFather token.
TELEGRAM_BOT_TOKEN=replace-with-other-bot-token
TELEGRAM_ENABLE_USER_WHITELIST=false
TELEGRAM_ALLOWED_USER_IDS=8954064995

OPENAI_API_KEY=replace-with-your-api-key
OPENAI_BASE_URL=localhost:4000
OPENAI_MODEL=replace-with-model

HEROBOT_DB_PATH=data/other.sqlite3
HEROBOT_PERSONA=写这个 bot 的讨论角色，例如：你是反方评论员，擅长指出盲点。
HEROBOT_DEFAULT_TIMEZONE=Asia/Shanghai
HEROBOT_MAX_AGENT_STEPS=8
HEROBOT_REMINDER_INTERVAL_SECONDS=30
# Optional split DB paths. Empty values fall back to HEROBOT_DB_PATH.
HEROBOT_CORE_DB_PATH=
HEROBOT_NOTES_DB_PATH=
HEROBOT_CALENDAR_DB_PATH=

ENABLE_BOT_TO_BOT=true
TELEGRAM_ALLOWED_BOT_USERNAMES=

LOG_LEVEL=INFO
