# Copy this file to .env and fill in your regenerated BotFather token.
TELEGRAM_BOT_TOKEN=replace-with-your-token

# Comma-separated Telegram user ids allowed to use the assistant.
# Send /whoami to the bot to see your id.
TELEGRAM_ENABLE_USER_WHITELIST=true
TELEGRAM_ALLOWED_USER_IDS=123456789

# OpenAI-compatible API settings. Examples:
# OpenAI: OPENAI_BASE_URL=https://api.openai.com/v1
# DeepSeek: OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=replace-with-your-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

# Local persistent data path.
HEROBOT_DB_PATH=data/herobot.sqlite3
HEROBOT_PERSONA=
HEROBOT_DEFAULT_TIMEZONE=Asia/Shanghai
HEROBOT_MAX_AGENT_STEPS=8
HEROBOT_MCP_SERVER_COMMAND=herobot-mcp

# Group bot-to-bot messages are handled by the Agent through send_telegram_message.
ENABLE_BOT_TO_BOT=false
TELEGRAM_ALLOWED_BOT_USERNAMES=other_bot,review_bot

# Optional: set to DEBUG while developing.
LOG_LEVEL=INFO
